   ================================================== */


/* ==================================================
   0. ATURAN LAMA (BUKAN HEADER)
   ================================================== */

.elementor-widget-rt-course-category {
  visibility: visible;
}


/* ==================================================
   1. PENGATURAN DESAIN
   Satu-satunya tempat nilai ukuran/warna header.
   ================================================== */

.amikom-glass-header {
  /* Warna */
  --amk-text: #35104F;
  --amk-accent: #401187;
  --amk-hover: rgba(124, 43, 194, 0.08);
  --amk-border: rgba(124, 43, 194, 0.12);

  /* Glass */
  --amk-glass-blur: 25px;
  --amk-glass-saturation: 160%;
  --amk-header-opacity: 0.60;
  --amk-shadow: 0 8px 32px rgba(41, 18, 63, 0.12);

  /* Desktop */
  --amk-header-height: 60px;
  --amk-nav-height: 58px;
  --amk-nav-font: 14px;
  --amk-nav-padding-y: 16px;
  --amk-nav-padding-x: 14px;

  /* Dropdown desktop */
  --amk-dropdown-width: 220px;
  --amk-dropdown-opacity: 0.85;
  --amk-dropdown-radius: 12px;
  --amk-dropdown-padding: 8px;
  --amk-dropdown-gap: 8px;
  --amk-dropdown-font: 14px;

  /* Mobile */
  --amk-mobile-background: rgba(250, 247, 255, 0.88);
  --amk-mobile-radius: 20px;
  --amk-mobile-padding: 20px;
  --amk-mobile-font: 15px;
  --amk-mobile-submenu-font: 14px;

  /* Animasi */
  --amk-panel-duration: 0.32s;
  --amk-panel-offset: -20px;
  --amk-submenu-duration: 0.4s;

  /*
   * Batas tinggi submenu saat terbuka.
   * Naikkan jika menu sangat panjang atau bertingkat.
   */
  --amk-submenu-max-height: 1600px;

  /* Nilai awal; diperbarui otomatis oleh JavaScript */
  --amikom-menu-top: 62px;
}


/* ==================================================
   2. POSISI DAN PEMBUNGKUS HEADER
   Tanpa animasi masuk atau transisi posisi.
   ================================================== */

header.st-elementor-addons-header:has(.amikom-glass-header) {
  position: sticky;
  top: 0;
  z-index: 9999;
  overflow: visible;

  animation: none !important;
  transition: none !important;
}

/* Hindari dua sistem sticky berjalan bersamaan */
header.st-elementor-addons-header:has(.amikom-glass-header)
.st-elementor-addons-header-nav {
  position: relative;
  top: 0;
  left: auto;
  width: 100%;
  overflow: visible;
  background: transparent;
  box-shadow: none;

  transform: none !important;
  animation: none !important;
  transition: none !important;
}

/* Transisi glass pada ::before tidak terpengaruh */
.elementor .elementor-element.amikom-glass-header {
  position: relative;
  isolation: isolate;
  background: transparent;
  overflow: visible;

  animation: none !important;
  transition: none !important;
}

.amikom-glass-header .steam-wid-con {
  background: transparent;
}

/* Pembungkus widget tidak memotong dropdown */
.amikom-glass-header
.elementor-widget.elementor-widget-stea_header_nav_menu
> .elementor-widget-container,
.amikom-glass-header
.amikom-mobile-nav > .elementor-widget-container,
.amikom-glass-header
.amikom-mobile-nav .steam-wid-con {
  overflow: visible;
}


/* ==================================================
   3. BACKGROUND GLASS HEADER
   ================================================== */

.amikom-glass-header::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  border-radius: inherit;
  pointer-events: none;

  background: #FFFFFF;
  box-shadow: none;
  -webkit-backdrop-filter: none;
  backdrop-filter: none;

  transition:
    background-color 0.25s ease,
    box-shadow 0.25s ease;
}

/* Fallback tanpa dukungan blur */
.amikom-glass-header.is-scrolled::before {
  background: rgba(255, 255, 255, 0.95);
  box-shadow: var(--amk-shadow);
}

@supports (
  (backdrop-filter: blur(1px)) or
  (-webkit-backdrop-filter: blur(1px))
) {
  .amikom-glass-header.is-scrolled::before {
    background: rgba(
      255, 255, 255, var(--amk-header-opacity)
    );

    -webkit-backdrop-filter:
      blur(var(--amk-glass-blur))
      saturate(var(--amk-glass-saturation));

    backdrop-filter:
      blur(var(--amk-glass-blur))
      saturate(var(--amk-glass-saturation));
  }
}


/* ==================================================
   4. IKON DROPDOWN: DESKTOP DAN MOBILE
   ================================================== */

/*
 * !important dibatasi pada tampilan ikon untuk
 * menimpa warna/border dari pengaturan widget/plugin.
 */
.amikom-glass-header
.elementor-widget-stea_header_nav_menu
.stea-submenu-indicator,
.amikom-glass-header
.amikom-mobile-nav .stea-submenu-indicator {
  color: var(--amk-text) !important;
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
}

/* Ikon font */
.amikom-glass-header
.stea-submenu-indicator::before {
  color: inherit;
}

/* Ikon SVG berbentuk solid */
.amikom-glass-header svg.stea-submenu-indicator,
.amikom-glass-header .stea-submenu-indicator svg {
  fill: currentColor;
}

/* Ikuti warna indikator pada bentuk SVG */
.amikom-glass-header .stea-submenu-indicator
svg [fill]:not([fill="none"]) {
  fill: currentColor;
}

.amikom-glass-header .stea-submenu-indicator
svg [stroke]:not([stroke="none"]) {
  stroke: currentColor;
}


/* ==================================================
   5. NAVBAR DAN DROPDOWN DESKTOP (>= 1025px)
   ================================================== */

@media (min-width: 1025px) {

  /* Tinggi header mengikuti variabel */
  .elementor .elementor-element.amikom-glass-header {
    --min-height: var(--amk-header-height);
    min-height: var(--amk-header-height);
  }

  /* Sembunyikan widget navigasi khusus mobile */
  .amikom-glass-header .amikom-mobile-nav {
    display: none !important;
  }

  /* Kontrol off-canvas tidak diperlukan di desktop */
  .amikom-glass-header
  .elementor-widget-stea_header_nav_menu
  :is(
    .stea-menu-hamburger,
    .stea-nav-identity-panel,
    .stea-menu-close,
    .stea-menu-overlay
  ) {
    display: none !important;
  }

  .amikom-glass-header
  .elementor-element.elementor-widget-stea_header_nav_menu
  .stea-menu-container {
    height: auto;
    min-height: var(--amk-nav-height);
    background: transparent;
    overflow: visible;
  }

  /* Menu utama langsung horizontal sejak pemuatan awal */
  .amikom-glass-header
  .elementor-widget-stea_header_nav_menu
  .stea-navbar-nav {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-wrap: nowrap;

    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Acuan posisi setiap dropdown */
  .amikom-glass-header
  .elementor-widget-stea_header_nav_menu
  .stea-navbar-nav li {
    position: relative;
  }

  /* Link menu utama */
  .amikom-glass-header
  .elementor-element.elementor-widget-stea_header_nav_menu
  .stea-navbar-nav > li > a {
    padding:
      var(--amk-nav-padding-y)
      var(--amk-nav-padding-x);

    font-size: var(--amk-nav-font);
    line-height: 1.5;
  }

  /*
   * Keadaan awal dropdown: tidak menambah tinggi header,
   * meskipun stylesheet plugin belum siap.
   */
  .amikom-glass-header
  .elementor-widget-stea_header_nav_menu
  .stea-navbar-nav .stea-dropdown {
    position: absolute;
    display: block;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* Dropdown tingkat pertama */
  .amikom-glass-header
  .elementor-widget-stea_header_nav_menu
  .stea-navbar-nav > li > .stea-dropdown {
    top: 100%;
    left: 0;
  }

  /* Terbuka lewat mouse atau keyboard */
  .amikom-glass-header
  .elementor-widget-stea_header_nav_menu
  .stea-navbar-nav li:is(:hover, :focus-within)
  > .stea-dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  /* Panel dropdown */
  .amikom-glass-header
  .elementor-widget-stea_header_nav_menu
  .stea-navbar-nav-default
  .stea-dropdown.stea-submenu-panel {
    box-sizing: border-box;
    min-width: var(--amk-dropdown-width);
    margin: 0;
    padding: var(--amk-dropdown-padding);

    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(227, 220, 234, 0.85);
    border-radius: var(--amk-dropdown-radius);
    box-shadow: var(--amk-shadow);

    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  @supports (
    (backdrop-filter: blur(1px)) or
    (-webkit-backdrop-filter: blur(1px))
  ) {
    .amikom-glass-header
    .elementor-widget-stea_header_nav_menu
    .stea-navbar-nav-default
    .stea-dropdown.stea-submenu-panel {
      background: rgba(
        255, 255, 255, var(--amk-dropdown-opacity)
      );

      -webkit-backdrop-filter:
        blur(var(--amk-glass-blur))
        saturate(var(--amk-glass-saturation));

      backdrop-filter:
        blur(var(--amk-glass-blur))
        saturate(var(--amk-glass-saturation));
    }
  }

  .amikom-glass-header
  .stea-navbar-nav-default .stea-dropdown > li {
    margin: 0;
  }

  /* Link dalam dropdown */
  .amikom-glass-header
  .elementor-widget-stea_header_nav_menu
  .stea-navbar-nav-default
  .stea-dropdown.stea-submenu-panel > li > a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;

    padding: 10px 12px;
    color: var(--amk-text);
    background: transparent;
    border-radius: 8px;

    font-size: var(--amk-dropdown-font);
    line-height: 1.5;
    white-space: normal;
    overflow-wrap: anywhere;

    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .amikom-glass-header
  .elementor-widget-stea_header_nav_menu
  .stea-navbar-nav-default
  .stea-dropdown.stea-submenu-panel > li:hover > a,
  .amikom-glass-header
  .elementor-widget-stea_header_nav_menu
  .stea-navbar-nav-default
  .stea-dropdown.stea-submenu-panel > li > a:focus-visible {
    color: var(--amk-accent);
    background: var(--amk-hover);
  }

  /* Submenu bertingkat ke kanan */
  .amikom-glass-header
  .stea-navbar-nav-default
  .stea-dropdown > li > .stea-dropdown {
    top: calc(0px - var(--amk-dropdown-padding) - 1px);
    left: calc(
      100% + var(--amk-dropdown-padding) +
      1px + var(--amk-dropdown-gap)
    );
    right: auto;
    margin: 0;
  }

  /* Jembatan hover antarpanel */
  .amikom-glass-header
  .stea-dropdown > li > .stea-dropdown::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    right: 100%;
    left: auto;

    width: calc(
      var(--amk-dropdown-padding) +
      var(--amk-dropdown-gap) + 2px
    );

    background: transparent;
  }

  /* Ikuti arah kiri dari plugin */
  .amikom-glass-header
  .stea-navbar-nav-default
  .stea-dropdown > li > .stea-dropdown.open-fromleft {
    left: auto;
    right: calc(
      100% + var(--amk-dropdown-padding) +
      1px + var(--amk-dropdown-gap)
    );
  }

  .amikom-glass-header
  .stea-dropdown > li > .stea-dropdown.open-fromleft::before {
    right: auto;
    left: 100%;
  }
}


/* ==================================================
   6. PANEL NAVIGASI TABLET DAN MOBILE (<= 1024px)
   Buka/tutup dikelola plugin lewat class .active
   ================================================== */

/* Hormati "Hide on Tablet" pada navigasi desktop */
@media (min-width: 768px) and (max-width: 1024px) {
  .amikom-glass-header
  .elementor-widget-stea_header_nav_menu.elementor-hidden-tablet {
    display: none !important;
  }
}

@media (max-width: 1024px) {

  /* Panel tertutup */
  .amikom-glass-header
  .amikom-mobile-nav .stea-menu-container {
    position: fixed;
    top: var(--amikom-menu-top);
    right: 0;
    bottom: auto;
    left: 0;

    box-sizing: border-box;
    width: 100%;
    max-width: none;
    min-height: 0;

    /* Menimpa tinggi !important bawaan plugin */
    height: auto !important;

    max-height: calc(100vh - var(--amikom-menu-top));
    max-height: calc(100dvh - var(--amikom-menu-top));

    margin: 0;
    padding:
      16px
      var(--amk-mobile-padding)
      calc(24px + env(safe-area-inset-bottom));

    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior-y: contain;

    background: #FAF7FF;
    border: 0;
    border-top: 1px solid var(--amk-border);
    border-radius:
      0 0
      var(--amk-mobile-radius)
      var(--amk-mobile-radius);

    box-shadow: 0 18px 36px rgba(41, 18, 63, 0.16);
    z-index: 10000;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(var(--amk-panel-offset));

    transition:
      transform var(--amk-panel-duration) ease,
      opacity var(--amk-panel-duration) ease,
      visibility 0s linear var(--amk-panel-duration);
  }

  @supports (
    (backdrop-filter: blur(1px)) or
    (-webkit-backdrop-filter: blur(1px))
  ) {
    .amikom-glass-header
    .amikom-mobile-nav .stea-menu-container {
      background: var(--amk-mobile-background);

      -webkit-backdrop-filter:
        blur(var(--amk-glass-blur))
        saturate(var(--amk-glass-saturation));

      backdrop-filter:
        blur(var(--amk-glass-blur))
        saturate(var(--amk-glass-saturation));
    }
  }

  /* Panel terbuka */
  .amikom-glass-header
  .amikom-mobile-nav .stea-menu-container.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    transition-delay: 0s;
  }

  /* Burger memiliki area klik tetap */
  .amikom-glass-header
  .amikom-mobile-nav .stea-menu-hamburger {
    box-sizing: border-box;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
  }

  /* Menutup menu cukup lewat hamburger */
  .amikom-glass-header
  .amikom-mobile-nav
  :is(
    .stea-nav-identity-panel,
    .stea-menu-close,
    .stea-menu-overlay
  ) {
    display: none !important;
  }

  /* Daftar menu utama */
  .amikom-glass-header
  .amikom-mobile-nav .stea-navbar-nav {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: visible;
    list-style: none;
  }

  .amikom-glass-header
  .amikom-mobile-nav .stea-navbar-nav li {
    width: 100%;
    margin: 0;
    list-style: none;
  }

  .amikom-glass-header
  .amikom-mobile-nav .stea-navbar-nav > li + li {
    border-top: 1px solid var(--amk-border);
  }

  /* Link menu */
  .amikom-glass-header
  .amikom-mobile-nav .stea-navbar-nav li > a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;

    box-sizing: border-box;
    min-height: 48px;
    height: auto;
    padding: 12px 14px;

    color: var(--amk-text);
    background: transparent;
    border-radius: 8px;

    font-size: var(--amk-mobile-font);
    font-weight: 600;
    line-height: 1.5;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .amikom-glass-header
  .amikom-mobile-nav
  .stea-navbar-nav li > a:is(:hover, :focus-visible) {
    color: var(--amk-accent);
    background: var(--amk-hover);
  }

  /* Submenu tertutup */
  .amikom-glass-header
  .amikom-mobile-nav
  .stea-navbar-nav-default
  .stea-navbar-nav
  .stea-dropdown.stea-submenu-panel {
    display: block;
    position: static;

    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    max-height: 0;
    margin: 0;
    padding: 0 0 0 16px;

    overflow: hidden;
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    transform: none;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transition:
      max-height var(--amk-submenu-duration) ease,
      opacity 0.2s ease,
      visibility 0s linear var(--amk-submenu-duration);
  }

  /* Submenu terbuka */
  .amikom-glass-header
  .amikom-mobile-nav
  .stea-navbar-nav-default
  .stea-navbar-nav
  .stea-dropdown.stea-submenu-panel.stea-dropdown-open {
    max-height: var(--amk-submenu-max-height);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .amikom-glass-header
  .amikom-mobile-nav .stea-dropdown > li > a {
    font-size: var(--amk-mobile-submenu-font);
    font-weight: 500;
  }

  .amikom-glass-header
  .amikom-mobile-nav .stea-dropdown::before {
    content: none;
  }

  /* Panah tanpa border; warna dasar di bagian 4 */
  .amikom-glass-header
  .amikom-mobile-nav
  .stea-dropdown-has > a .stea-submenu-indicator {
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .amikom-glass-header
  .amikom-mobile-nav
  .stea-dropdown-has:has(> .stea-dropdown-open)
  > a .stea-submenu-indicator {
    color: var(--amk-accent) !important;
    transform: rotate(180deg);
  }
}


/* ==================================================
   7. HEADER FIXED PADA MOBILE (<= 767px)
   ================================================== */

@media (max-width: 767px) {

  .amikom-glass-header
  .elementor-widget-stea_header_nav_menu.elementor-hidden-mobile {
    display: none !important;
  }

  header.st-elementor-addons-header:has(.amikom-glass-header) {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    width: 100%;
  }

  /*
   * Tinggi aktual diukur oleh JavaScript header.
   * 80px hanya fallback jika JS belum berjalan.
   */
  body:has(header.st-elementor-addons-header .amikom-glass-header) {
    padding-top: var(--amikom-mobile-header-height, 80px);
  }
}


/* ==================================================
   8. ADMIN BAR WORDPRESS
   ================================================== */

body.admin-bar
header.st-elementor-addons-header:has(.amikom-glass-header) {
  top: 32px;
}

@media (min-width: 601px) and (max-width: 782px) {
  body.admin-bar
  header.st-elementor-addons-header:has(.amikom-glass-header) {
    top: 46px;
  }
}

@media (max-width: 600px) {
  body.admin-bar
  header.st-elementor-addons-header:has(.amikom-glass-header) {
    top: var(--amikom-mobile-admin-offset, 0px);
  }
}


/* ==================================================
   9. AKSESIBILITAS
   ================================================== */

.amikom-glass-header .stea-dropdown a:focus-visible,
.amikom-glass-header .amikom-mobile-nav a:focus-visible,
.amikom-glass-header .amikom-mobile-nav button:focus-visible {
  outline: 2px solid var(--amk-accent);
  outline-offset: -2px;
}

@media (prefers-reduced-motion: reduce) {
  .amikom-glass-header::before,
  .amikom-glass-header .stea-dropdown.stea-submenu-panel,
  .amikom-glass-header .stea-dropdown.stea-submenu-panel > li > a,
  .amikom-glass-header .amikom-mobile-nav .stea-menu-container,
  .amikom-glass-header .amikom-mobile-nav
  .stea-navbar-nav-default .stea-navbar-nav
  .stea-dropdown.stea-submenu-panel,
  .amikom-glass-header .amikom-mobile-nav
  .stea-dropdown-has > a .stea-submenu-indicator {
    transition: none;
  }

  .amikom-glass-header
  .amikom-mobile-nav .stea-menu-container {
    transform: none;
  }
}

@media (min-width: 1025px) {
  .amikom-glass-header
  .elementor-widget-stea_header_nav_menu
  .stea-navbar-nav > li > .stea-dropdown.stea-submenu-panel {
    background: rgba(255, 255, 255, var(--amk-dropdown-opacity)) !important;

    -webkit-backdrop-filter:
      blur(var(--amk-glass-blur))
      saturate(var(--amk-glass-saturation)) !important;

    backdrop-filter:
      blur(var(--amk-glass-blur))
      saturate(var(--amk-glass-saturation)) !important;
  }
}
</style>
</head>

<body class="home wp-singular page-template page-template-elementor_header_footer page page-id-13799 wp-embed-responsive wp-theme-eikra st-elementor-addons-template Eikra-version-4.4.19 header-style-8 footer-style-1 no-sidebar rt-course-grid-view product-grid-view elementor-default elementor-template-full-width elementor-kit-1973 elementor-page elementor-page-13799">
	<header class="st-elementor-addons-header" itemscope="itemscope" itemtype="https://schema.org/WPHeader">
		<p class="main-title stea-hidden" itemprop="headline"><a href="https://amikom.ac.id" title="Amikom &#8211; Kampus IT &amp; Creative Economy Terakreditasi Unggul" rel="home">Amikom &#8211; Kampus IT &amp; Creative Economy Terakreditasi Unggul</a></p>
		<nav class="st-elementor-addons-header-nav">
					<div data-elementor-type="stea-theme-template" data-elementor-id="15052" class="elementor elementor-15052 post-13799 page type-page status-publish hentry">
				<div class="elementor-element elementor-element-488d730c amikom-glass-header e-flex e-con-boxed e-con e-parent" data-id="488d730c" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
					<div class="e-con-inner">
		<div class="elementor-element elementor-element-74ed715b e-con-full e-flex e-con e-child" data-id="74ed715b" data-element_type="container" data-e-type="container">
