		<div class="elementor-element elementor-element-68580feb e-con-full e-flex e-con e-child" data-id="68580feb" data-element_type="container" data-e-type="container">
				<div class="elementor-element elementor-element-4aaf9f54 elementor-widget__width-initial elementor-widget elementor-widget-html" data-id="4aaf9f54" data-element_type="widget" data-e-type="widget" data-widget_type="html.default">
				<div class="elementor-widget-container">
					<style>
/* ==================================================
   1. PENGATURAN DESAIN
   ================================================== */

.amikom-glass-header {
  /* Warna */
  --amk-text: #35104F;
  --amk-accent: #401187;
  --amk-hover: rgba(124, 43, 194, 0.08);
  --amk-border: rgba(124, 43, 194, 0.12);

  /* Glass */
  --amk-glass-blur: 25px;
  --amk-glass-saturation: 160%;
  --amk-header-opacity: 0.60;
  --amk-shadow: 0 8px 32px rgba(41, 18, 63, 0.12);

  /* Desktop */
  --amk-header-height: 60px;
  --amk-nav-height: 58px;
  --amk-nav-font: 14px;
  --amk-nav-padding-y: 16px;
  --amk-nav-padding-x: 14px;

  /* Dropdown desktop */
  --amk-dropdown-width: 220px;
  --amk-dropdown-opacity: 0.85;
  --amk-dropdown-radius: 12px;
  --amk-dropdown-padding: 8px;
  --amk-dropdown-gap: 8px;
  --amk-dropdown-font: 14px;

  /* Mobile */
  --amk-mobile-background: rgba(250, 247, 255, 0.88);
  --amk-mobile-radius: 20px;
  --amk-mobile-padding: 20px;
  --amk-mobile-font: 15px;
  --amk-mobile-submenu-font: 14px;

  /* Animasi */
  --amk-panel-duration: 0.32s;
  --amk-panel-offset: -20px;
  --amk-submenu-duration: 0.4s;

  /*
   * Batas tinggi submenu saat terbuka.
   * Naikkan jika menu sangat panjang atau bertingkat.
   */
  --amk-submenu-max-height: 1600px;

  /* Diperbarui otomatis oleh JavaScript */
  --amikom-menu-top: 62px;
}


/* ==================================================
   2. POSISI DAN PEMBUNGKUS HEADER
   ================================================== */

header.st-elementor-addons-header:has(.amikom-glass-header) {
  position: sticky;
  top: 0;
  z-index: 9999;
  overflow: visible;
}

body.admin-bar
header.st-elementor-addons-header:has(.amikom-glass-header) {
  top: 32px;
}

/* Hindari dua sistem sticky berjalan bersamaan */
header.st-elementor-addons-header:has(.amikom-glass-header)
.st-elementor-addons-header-nav {
  position: relative;
  top: 0;
  left: auto;
  width: 100%;
  animation: none;
  transform: none;
  background: transparent;
  box-shadow: none;
  overflow: visible;
}

.elementor .elementor-element.amikom-glass-header {
  position: relative;
  isolation: isolate;
  background: transparent;
  overflow: visible;
}

.amikom-glass-header .steam-wid-con {
  background: transparent;
}

/* Perbaikan pembungkus widget yang memotong dropdown */
.amikom-glass-header
.elementor-widget.elementor-widget-stea_header_nav_menu
> .elementor-widget-container,
.amikom-glass-header
.amikom-mobile-nav > .elementor-widget-container,
.amikom-glass-header
.amikom-mobile-nav .steam-wid-con {
  overflow: visible;
}


/* ==================================================
   3. BACKGROUND GLASS HEADER
   ================================================== */

.amikom-glass-header::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  border-radius: inherit;
  pointer-events: none;

  background: #FFFFFF;
  box-shadow: none;
  -webkit-backdrop-filter: none;
  backdrop-filter: none;

  transition:
    background-color 0.25s ease,
    box-shadow 0.25s ease;
}

/* Fallback tanpa dukungan blur */
.amikom-glass-header.is-scrolled::before {
  background: rgba(255, 255, 255, 0.95);
  box-shadow: var(--amk-shadow);
}

@supports (
  (backdrop-filter: blur(1px)) or
  (-webkit-backdrop-filter: blur(1px))
) {
  .amikom-glass-header.is-scrolled::before {
    background: rgba(
      255, 255, 255, var(--amk-header-opacity)
    );

    -webkit-backdrop-filter:
      blur(var(--amk-glass-blur))
      saturate(var(--amk-glass-saturation));

    backdrop-filter:
      blur(var(--amk-glass-blur))
      saturate(var(--amk-glass-saturation));
  }
}


/* ==================================================
   4. IKON DROPDOWN — DESKTOP DAN MOBILE
   ================================================== */

/*
 * !important dibatasi pada tampilan ikon untuk
 * menimpa warna/border dari pengaturan widget/plugin.
 */
.amikom-glass-header
.elementor-widget-stea_header_nav_menu
.stea-submenu-indicator,
.amikom-glass-header
.amikom-mobile-nav .stea-submenu-indicator {
  color: var(--amk-text) !important;
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
}

/* Ikon font */
.amikom-glass-header
.stea-submenu-indicator::before {
  color: inherit;
}

/* Ikon SVG berbentuk solid */
.amikom-glass-header svg.stea-submenu-indicator,
.amikom-glass-header .stea-submenu-indicator svg {
  fill: currentColor;
}

/* Ikuti warna indikator pada bentuk SVG */
.amikom-glass-header .stea-submenu-indicator
svg [fill]:not([fill="none"]) {
  fill: currentColor;
}

.amikom-glass-header .stea-submenu-indicator
svg [stroke]:not([stroke="none"]) {
  stroke: currentColor;
}


/* ==================================================
   5. NAVBAR DAN DROPDOWN DESKTOP
   ================================================== */

@media (min-width: 1025px) {
  .elementor .elementor-element.amikom-glass-header {
    --min-height: var(--amk-header-height);
    min-height: var(--amk-header-height);
  }

  .amikom-glass-header
  .elementor-element.elementor-widget-stea_header_nav_menu
  .stea-menu-container {
    height: auto;
    min-height: var(--amk-nav-height);
    background: transparent;
    overflow: visible;
  }

  /* Menu utama */
  .amikom-glass-header
  .elementor-element.elementor-widget-stea_header_nav_menu
  .stea-navbar-nav > li > a {
    padding:
      var(--amk-nav-padding-y)
      var(--amk-nav-padding-x);

    font-size: var(--amk-nav-font);
    line-height: 1.5;
  }

  /* Panel dropdown */
  .amikom-glass-header
  .elementor-widget-stea_header_nav_menu
  .stea-navbar-nav-default
  .stea-dropdown.stea-submenu-panel {
    box-sizing: border-box;
    min-width: var(--amk-dropdown-width);
    margin: 0;
    padding: var(--amk-dropdown-padding);

    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(227, 220, 234, 0.85);
    border-radius: var(--amk-dropdown-radius);
    box-shadow: var(--amk-shadow);

    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  @supports (
    (backdrop-filter: blur(1px)) or
    (-webkit-backdrop-filter: blur(1px))
  ) {
    .amikom-glass-header
    .elementor-widget-stea_header_nav_menu
    .stea-navbar-nav-default
    .stea-dropdown.stea-submenu-panel {
      background: rgba(
        255, 255, 255, var(--amk-dropdown-opacity)
      );

      -webkit-backdrop-filter:
        blur(var(--amk-glass-blur))
        saturate(var(--amk-glass-saturation));

      backdrop-filter:
        blur(var(--amk-glass-blur))
        saturate(var(--amk-glass-saturation));
    }
  }

  .amikom-glass-header
  .stea-navbar-nav-default .stea-dropdown > li {
    position: relative;
    margin: 0;
  }

  /* Link dalam dropdown */
  .amikom-glass-header
  .elementor-widget-stea_header_nav_menu
  .stea-navbar-nav-default
  .stea-dropdown.stea-submenu-panel > li > a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;

    padding: 10px 12px;
    color: var(--amk-text);
    background: transparent;
    border-radius: 8px;

    font-size: var(--amk-dropdown-font);
    line-height: 1.5;
    white-space: normal;
    overflow-wrap: anywhere;

    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .amikom-glass-header
  .elementor-widget-stea_header_nav_menu
  .stea-navbar-nav-default
  .stea-dropdown.stea-submenu-panel > li:hover > a,
  .amikom-glass-header
  .elementor-widget-stea_header_nav_menu
  .stea-navbar-nav-default
  .stea-dropdown.stea-submenu-panel > li > a:focus-visible {
    color: var(--amk-accent);
    background: var(--amk-hover);
  }

  /* Hover dan keyboard */
  .amikom-glass-header
  .steam-nav-dropdown-hover
  .stea-dropdown-has:is(:hover, :focus-within)
  > .stea-dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  /* Submenu bertingkat ke kanan */
  .amikom-glass-header
  .stea-navbar-nav-default
  .stea-dropdown > li > .stea-dropdown {
    top: calc(0px - var(--amk-dropdown-padding) - 1px);
    left: calc(
      100% + var(--amk-dropdown-padding) +
      1px + var(--amk-dropdown-gap)
    );
    right: auto;
    margin: 0;
  }

  /* Jembatan hover antarpanel */
  .amikom-glass-header
  .stea-dropdown > li > .stea-dropdown::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    right: 100%;
    left: auto;

    width: calc(
      var(--amk-dropdown-padding) +
      var(--amk-dropdown-gap) + 2px
    );

    background: transparent;
  }

  /* Ikuti arah kiri dari plugin */
  .amikom-glass-header
  .stea-navbar-nav-default
  .stea-dropdown > li > .stea-dropdown.open-fromleft {
    left: auto;
    right: calc(
      100% + var(--amk-dropdown-padding) +
      1px + var(--amk-dropdown-gap)
    );
  }

  .amikom-glass-header
  .stea-dropdown > li > .stea-dropdown.open-fromleft::before {
    right: auto;
    left: 100%;
  }
}


/* ==================================================
   6. PANEL NAVIGASI TABLET DAN MOBILE
   ================================================== */

@media (max-width: 1024px) {
  /* Panel tertutup */
  .amikom-glass-header
  .amikom-mobile-nav .stea-menu-container {
    position: fixed;
    top: var(--amikom-menu-top);
    right: 0;
    bottom: auto;
    left: 0;

    box-sizing: border-box;
    width: 100%;
    max-width: none;
    min-height: 0;

    /* Menimpa tinggi !important bawaan plugin */
    height: auto !important;

    max-height: calc(100vh - var(--amikom-menu-top));
    max-height: calc(100dvh - var(--amikom-menu-top));

    margin: 0;
    padding:
      16px
      var(--amk-mobile-padding)
      calc(24px + env(safe-area-inset-bottom));

    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior-y: contain;

    background: #FAF7FF;
    border: 0;
    border-top: 1px solid var(--amk-border);
    border-radius:
      0 0
      var(--amk-mobile-radius)
      var(--amk-mobile-radius);

    box-shadow: 0 18px 36px rgba(41, 18, 63, 0.16);
    z-index: 10000;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(var(--amk-panel-offset));

    transition:
      transform var(--amk-panel-duration) ease,
      opacity var(--amk-panel-duration) ease,
      visibility 0s linear var(--amk-panel-duration);
  }

  @supports (
    (backdrop-filter: blur(1px)) or
    (-webkit-backdrop-filter: blur(1px))
  ) {
    .amikom-glass-header
    .amikom-mobile-nav .stea-menu-container {
      background: var(--amk-mobile-background);

      -webkit-backdrop-filter:
        blur(var(--amk-glass-blur))
        saturate(var(--amk-glass-saturation));

      backdrop-filter:
        blur(var(--amk-glass-blur))
        saturate(var(--amk-glass-saturation));
    }
  }

  /* Class .active dikelola oleh ST Addons */
  .amikom-glass-header
  .amikom-mobile-nav .stea-menu-container.active {
    left: 0;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    transition-delay: 0s;
  }

  /* Menutup menu cukup lewat hamburger */
  .amikom-glass-header
  .amikom-mobile-nav .stea-nav-identity-panel,
  .amikom-glass-header
  .amikom-mobile-nav .stea-menu-overlay {
    display: none;
  }

  /* Daftar menu utama */
  .amikom-glass-header
  .amikom-mobile-nav .stea-navbar-nav {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: visible;
    list-style: none;
  }

  .amikom-glass-header
  .amikom-mobile-nav .stea-navbar-nav li {
    width: 100%;
    margin: 0;
    list-style: none;
  }

  .amikom-glass-header
  .amikom-mobile-nav .stea-navbar-nav > li + li {
    border-top: 1px solid var(--amk-border);
  }

  /* Link menu */
  .amikom-glass-header
  .amikom-mobile-nav .stea-navbar-nav li > a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;

    box-sizing: border-box;
    min-height: 48px;
    height: auto;
    padding: 12px 14px;

    color: var(--amk-text);
    background: transparent;
    border-radius: 8px;

    font-size: var(--amk-mobile-font);
    font-weight: 600;
    line-height: 1.5;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .amikom-glass-header
  .amikom-mobile-nav
  .stea-navbar-nav li > a:is(:hover, :focus-visible) {
    color: var(--amk-accent);
    background: var(--amk-hover);
  }

  /* Submenu tertutup */
  .amikom-glass-header
  .amikom-mobile-nav
  .stea-navbar-nav-default
  .stea-navbar-nav
  .stea-dropdown.stea-submenu-panel {
    display: block;
    position: static;

    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    max-height: 0;
    margin: 0;
    padding: 0 0 0 16px;

    overflow: hidden;
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    transform: none;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transition:
      max-height var(--amk-submenu-duration) ease,
      opacity 0.2s ease,
      visibility 0s linear var(--amk-submenu-duration);
  }

  /* Submenu terbuka */
  .amikom-glass-header
  .amikom-mobile-nav
  .stea-navbar-nav-default
  .stea-navbar-nav
  .stea-dropdown.stea-submenu-panel.stea-dropdown-open {
    max-height: var(--amk-submenu-max-height);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .amikom-glass-header
  .amikom-mobile-nav .stea-dropdown > li > a {
    font-size: var(--amk-mobile-submenu-font);
    font-weight: 500;
  }

  .amikom-glass-header
  .amikom-mobile-nav .stea-dropdown::before {
    content: none;
  }

  /* Panah tanpa border; warna dasar di bagian 4 */
  .amikom-glass-header
  .amikom-mobile-nav
  .stea-dropdown-has > a .stea-submenu-indicator {
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .amikom-glass-header
  .amikom-mobile-nav
  .stea-dropdown-has:has(> .stea-dropdown-open)
  > a .stea-submenu-indicator {
    color: var(--amk-accent) !important;
    transform: rotate(180deg);
  }
}


/* ==================================================
   7. POSISI MOBILE DAN ADMIN BAR WORDPRESS
   ================================================== */

@media (min-width: 601px) and (max-width: 782px) {
  body.admin-bar
  header.st-elementor-addons-header:has(.amikom-glass-header) {
    top: 46px;
  }
}

@media (max-width: 767px) {
  header.st-elementor-addons-header:has(.amikom-glass-header) {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    width: 100%;
  }

  body:has(header.st-elementor-addons-header .amikom-glass-header) {
    padding-top: var(--amikom-mobile-header-height, 80px);
  }
}

@media (max-width: 600px) {
  body.admin-bar
  header.st-elementor-addons-header:has(.amikom-glass-header) {
    top: var(--amikom-mobile-admin-offset, 0px);
  }
}


/* ==================================================
   8. AKSESIBILITAS
   ================================================== */

.amikom-glass-header .stea-dropdown a:focus-visible,
.amikom-glass-header .amikom-mobile-nav a:focus-visible,
.amikom-glass-header .amikom-mobile-nav button:focus-visible {
  outline: 2px solid var(--amk-accent);
  outline-offset: -2px;
}

@media (prefers-reduced-motion: reduce) {
  .amikom-glass-header::before,
  .amikom-glass-header .stea-dropdown.stea-submenu-panel,
  .amikom-glass-header .stea-dropdown.stea-submenu-panel > li > a,
  .amikom-glass-header .amikom-mobile-nav .stea-menu-container,
  .amikom-glass-header .amikom-mobile-nav
  .stea-navbar-nav-default .stea-navbar-nav
  .stea-dropdown.stea-submenu-panel,
  .amikom-glass-header .amikom-mobile-nav
  .stea-dropdown-has > a .stea-submenu-indicator {
    transition: none;
  }

  .amikom-glass-header
  .amikom-mobile-nav .stea-menu-container {
    transform: none;
  }
}

</style>

<script>
(function () {
  "use strict";

  /* =================================================
     1. KONFIGURASI
     ================================================= */

  const INSTANCE_KEY = "__amikomGlassHeaderController";

  const SELECTOR = {
    outerHeader:
      "header.st-elementor-addons-header:has(.amikom-glass-header)",
    glassHeader: ".amikom-glass-header",
    mobileWidget: ".amikom-mobile-nav",
    menuPanel: ".stea-menu-container",
    hamburger: ".stea-menu-hamburger"
  };

  const BREAKPOINT = {
    mobileHeader: 767,
    mobileMenu: 1024
  };

  const SCROLL_THRESHOLD = 8;

  /* Hindari listener ganda saat Elementor merender ulang */
  const previous = window[INSTANCE_KEY];

  if (previous) {
    if (typeof previous.destroy === "function") {
      previous.destroy();
    } else {
      previous.refresh?.();
      return;
    }
  }

  const root = document.documentElement;
  const events = new AbortController();
  const observedHeaders = new Set();

  let frameId = null;
  let destroyed = false;

  /* =================================================
     2. UTILITAS
     ================================================= */

  function setVariable(element, name, value) {
    if (element.style.getPropertyValue(name) !== value) {
      element.style.setProperty(name, value);
    }
  }

  function closeMobileMenus() {
    document.querySelectorAll(
      SELECTOR.glassHeader + " " + SELECTOR.mobileWidget
    ).forEach(function (widget) {
      const panel = widget.querySelector(SELECTOR.menuPanel);
      const hamburger = widget.querySelector(SELECTOR.hamburger);

      if (!panel?.classList.contains("active")) return;

      /*
       * Gunakan hamburger yang sama dengan interaksi pengguna.
       * Buka-tutup tetap dikelola oleh ST Addons.
       */
      const hadFocus = widget.contains(document.activeElement);

      hamburger?.click();

      if (hadFocus) {
        hamburger?.focus();
      }
    });
  }

  /* =================================================
     3. PENGUKURAN HEADER
     ================================================= */

  function updateHeaders() {
    frameId = null;
    if (destroyed) return;

    const outerHeaders = Array.from(
      document.querySelectorAll(SELECTOR.outerHeader)
    );

    const visibleOuterHeader = outerHeaders.find(function (header) {
      return header.getBoundingClientRect().height > 0;
    });

    const isMobile = window.innerWidth <= BREAKPOINT.mobileHeader;
    const isScrolled = window.scrollY > SCROLL_THRESHOLD;

    if (visibleOuterHeader && isMobile) {
      const adminBar = document.getElementById("wpadminbar");

      const adminOffset = adminBar
        ? Math.max(0, adminBar.getBoundingClientRect().bottom)
        : 0;

      setVariable(
        root,
        "--amikom-mobile-admin-offset",
        Math.ceil(adminOffset) + "px"
      );

      setVariable(
        root,
        "--amikom-mobile-header-height",
        Math.ceil(
          visibleOuterHeader.getBoundingClientRect().height
        ) + "px"
      );
    } else {
      root.style.removeProperty("--amikom-mobile-admin-offset");
      root.style.removeProperty("--amikom-mobile-header-height");
    }

    document.querySelectorAll(SELECTOR.glassHeader).forEach(
      function (header) {
        header.classList.toggle("is-scrolled", isScrolled);

        const outer = header.closest(SELECTOR.outerHeader);
        const reference = outer || header;

        const headerBottom = Math.max(
          0,
          reference.getBoundingClientRect().bottom
        );

        setVariable(
          header,
          "--amikom-menu-top",
          Math.ceil(headerBottom) + "px"
        );
      }
    );

    observeHeaderSizes(outerHeaders);
  }

  function scheduleUpdate() {
    if (destroyed || frameId !== null) return;
    frameId = window.requestAnimationFrame(updateHeaders);
  }

  const sizeObserver = typeof ResizeObserver !== "undefined"
    ? new ResizeObserver(scheduleUpdate)
    : null;

  function observeHeaderSizes(headers) {
    if (!sizeObserver) return;

    observedHeaders.forEach(function (header) {
      if (!header.isConnected) {
        sizeObserver.unobserve(header);
        observedHeaders.delete(header);
      }
    });

    headers.forEach(function (header) {
      if (observedHeaders.has(header)) return;

      sizeObserver.observe(header);
      observedHeaders.add(header);
    });
  }

  /* =================================================
     4. EVENT HALAMAN
     ================================================= */

  window.addEventListener("scroll", scheduleUpdate, {
    passive: true,
    signal: events.signal
  });

  window.addEventListener("resize", scheduleUpdate, {
    signal: events.signal
  });

  document.addEventListener("keydown", function (event) {
    if (event.key !== "Escape") return;
    if (window.innerWidth > BREAKPOINT.mobileMenu) return;

    closeMobileMenus();
  }, {
    signal: events.signal
  });

  /* =================================================
     5. RENDER ULANG ELEMENTOR
     ================================================= */

  const domObserver = new MutationObserver(function (records) {
    const headerAdded = records.some(function (record) {
      return Array.from(record.addedNodes).some(function (node) {
        return node.nodeType === 1 && (
          node.matches(SELECTOR.glassHeader) ||
          node.querySelector(SELECTOR.glassHeader)
        );
      });
    });

    if (headerAdded) scheduleUpdate();
  });

  domObserver.observe(root, {
    childList: true,
    subtree: true
  });

  /* =================================================
     6. CLEANUP DAN INISIALISASI
     ================================================= */

  function destroy() {
    destroyed = true;

    events.abort();
    domObserver.disconnect();
    sizeObserver?.disconnect();
    observedHeaders.clear();

    if (frameId !== null) {
      window.cancelAnimationFrame(frameId);
      frameId = null;
    }
  }

  window[INSTANCE_KEY] = {
    refresh: scheduleUpdate,
    destroy: destroy
  };

  if (document.readyState === "loading") {
    document.addEventListener(
      "DOMContentLoaded",
      scheduleUpdate,
      { once: true, signal: events.signal }
    );
  } else {
    scheduleUpdate();
  }

  window.addEventListener(
    "load",
    scheduleUpdate,
    { once: true, signal: events.signal }
  );

  if (document.fonts) {
    document.fonts.ready.then(scheduleUpdate);
  }
})();
</script>				</div>
